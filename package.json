{
  "name": "bpmn-code-generator",
  "private": true,
  "version": "1.0.0",
  "description": "Generate BPMN 2.0 diagrams from JSON/YAML using React, Vite and bpmn-js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
